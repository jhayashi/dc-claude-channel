{
  "name": "claude-channel-deltachat",
  "version": "0.1.0",
  "type": "module",
  "bin": "./server.ts",
  "scripts": {
    "start": "bun server.ts",
    "build:xdcs": "bun scripts/build-all-xdcs.ts",
    "build:badges": "bun scripts/build-all-badges.ts",
    "build:prebuilt": "bun scripts/build-all-xdcs.ts && bun scripts/build-all-badges.ts",
    "test:safe": "bash scripts/run-tests.sh --wait",
    "test:webxdc": "cd test/webxdc && bunx playwright test",
    "test:integration": "DC_INTEGRATION_TEST=1 bun test test/integration"
  },
  "dependencies": {
    "@deltachat/jsonrpc-client": "*",
    "@deltachat/stdio-rpc-server": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/whisper": "^0.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "cron-parser": "5.5.0",
    "fflate": "^0.8.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "prismjs": "^1.30.0"
  }
}
